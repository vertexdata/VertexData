{
  "redirects": [
    {
      "source": "/locations",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/locations/:path*",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}
